BOT_TOKEN=your_token_here
CHAT_ID=your_chat_id_here
TODOIST_TOKEN=your_todoist_api_token_here  # необязательно

# Общий state.json для синхронизации между устройствами (необязательно).
# Укажи один и тот же путь в .env на всех машинах.
#
# iCloud Drive (Mac):
# STATE_FILE=~/Library/Mobile Documents/com~apple~CloudDocs/flowbot/state.json
#
# iCloud Drive (Windows):
# STATE_FILE=C:\Users\ВАШ_ПОЛЬЗОВАТЕЛЬ\iCloudDrive\flowbot\state.json
#
# Dropbox (Mac):
# STATE_FILE=~/Dropbox/flowbot/state.json
#
# Dropbox (Windows):
# STATE_FILE=C:\Users\ВАШ_ПОЛЬЗОВАТЕЛЬ\Dropbox\flowbot\state.json
